<UserControl x:Class="OpenNotch.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Os blocos são montados em HomeView.xaml.cs, na ordem escolhida nas configurações.
         Se não couberem na largura do notch, a fileira rola para o lado. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Blocks" Orientation="Horizontal" />
    </ScrollViewer>
</UserControl>
