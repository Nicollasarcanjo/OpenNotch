<UserControl x:Class="OpenNotch.MusicBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenNotch" Width="300" VerticalAlignment="Center">
    <Grid>
        <StackPanel Visibility="{Binding HasSession, Converter={StaticResource Hidden}}">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource Dim}"
                       HorizontalAlignment="Left" />
            <TextBlock Text="{l:T 'Nada tocando'}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2" />
            <TextBlock Text="{l:T 'Dê play em qualquer player ou no navegador.'}" Foreground="{StaticResource Dim}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Grid Visibility="{Binding HasSession, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="104" Height="104" CornerRadius="12" Background="{StaticResource Card}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,104,104" RadiusX="12" RadiusY="12" />
                </Border.Clip>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Album}" Foreground="{StaticResource Faint}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="-8,8,0,0">
                    <Button Style="{StaticResource Flat}" Click="OnPrevious">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource Flat}" Click="OnPlayPause">
                        <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="20" />
                    </Button>
                    <Button Style="{StaticResource Flat}" Click="OnNext">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="15" />
                    </Button>
                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource Faint}" FontSize="10"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
