<Window x:Class="OpenNotch.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenNotch"
        Title="{l:T 'Bem-vindo ao OpenNotch'}" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1C1C1E"
        TextElement.Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/OpenNotch;component/src/views/darkcontrols.xaml" />
    </Window.Resources>
    <StackPanel Margin="26">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image x:Name="Logo" Width="56" Height="56" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T 'Bem-vindo ao OpenNotch'}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{l:T 'Passe o mouse no centro do topo da tela para abrir o painel.'}"
                           Foreground="#B0FFFFFF" />
            </StackPanel>
        </StackPanel>

        <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{l:T 'Permissões'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="#B0FFFFFF"
                           Text="{l:T 'No Windows o OpenNotch não precisa de nenhuma permissão especial: música, volume por app, prints e a lista de apps já funcionam. Nada é enviado para fora do computador.'}" />
            </StackPanel>
        </Border>

        <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{l:T 'Como você quer usar'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DockPanel LastChildFill="False" Margin="0,4">
                    <CheckBox x:Name="Startup" DockPanel.Dock="Right" Style="{StaticResource Switch}" />
                    <TextBlock VerticalAlignment="Center" Text="{l:T 'Abrir ao iniciar o Windows'}" />
                </DockPanel>
                <DockPanel LastChildFill="False" Margin="0,4">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HoverOpens}" />
                    <TextBlock VerticalAlignment="Center" Text="{l:T 'Abrir ao passar o mouse'}" />
                </DockPanel>
                <DockPanel LastChildFill="False" Margin="0,4">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowClosedIndicators}" />
                    <TextBlock VerticalAlignment="Center" Text="{l:T 'Mostrar indicadores com o notch fechado'}" />
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#80FFFFFF" FontSize="11" Margin="0,2,0,0"
                           Text="{l:T 'Desligado, o notch fica minimizado no topo da tela e só aparece ao passar o mouse.'}" />
            </StackPanel>
        </Border>

        <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{l:T 'Dicas'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="#B0FFFFFF"
                           Text="{l:T '• Ctrl + Alt + N abre e fecha o notch pelo teclado.'}" />
                <TextBlock TextWrapping="Wrap" Foreground="#B0FFFFFF"
                           Text="{l:T '• A engrenagem dentro do notch abre as configurações, onde tudo pode ser ligado ou desligado.'}" />
                <TextBlock TextWrapping="Wrap" Foreground="#B0FFFFFF"
                           Text="{l:T '• O ícone do OpenNotch fica na área de notificação, perto do relógio.'}" />
            </StackPanel>
        </Border>

        <Button Style="{StaticResource Prominent}" Content="{l:T 'Começar a usar'}" HorizontalAlignment="Right" Padding="18,6"
                IsDefault="True" Click="OnDone" />
    </StackPanel>
</Window>
