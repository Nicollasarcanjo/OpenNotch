<Window x:Class="OpenNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenNotch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="700" Height="250" AllowDrop="True" Title="OpenNotch">
    <Window.Resources>
        <ResourceDictionary Source="/OpenNotch;component/src/views/darkcontrols.xaml" />
    </Window.Resources>

    <!-- A janela é maior que o notch e transparente. "Root" junta a faixa sensível ao mouse
         (quase invisível, no topo) e a casca preta: passar o mouse em qualquer uma abre o painel. -->
    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border x:Name="HoverZone" Width="260" Height="7" VerticalAlignment="Top" Background="#01000000" />
        <Border x:Name="Shell" Background="Black" CornerRadius="0,0,4,4" HorizontalAlignment="Center"
                VerticalAlignment="Top" Width="150" Height="4" ClipToBounds="True" Opacity="0.6"
                TextElement.Foreground="White" TextElement.FontSize="12"
                TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
            <Grid>
                <Grid x:Name="ClosedView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="EarArtwork" Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0"
                           Stretch="UniformToFill" />
                    <!-- Verso da música, no centro; a capa e o indicador ficam nas pontas. -->
                    <l:OutlinedText x:Name="LyricLine" Grid.ColumnSpan="2" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    <TextBlock x:Name="EarText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="11" FontWeight="SemiBold" Foreground="#FF9F0A" />
                </Grid>
                <!-- Tamanho fixo e centralizado: enquanto a casca cresce, o conteúdo "se revela" do centro. -->
                <Grid x:Name="OpenView" Visibility="Collapsed" Width="640" Height="224" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="OpenShift" Y="-8" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,6,14,0" LastChildFill="False">
                        <StackPanel x:Name="TabBar" Orientation="Horizontal" DockPanel.Dock="Left" />
                        <Button x:Name="GearButton" DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="OnGear">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="TabTitle" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource Dim}" FontSize="11" />
                    </DockPanel>
                    <ContentControl x:Name="TabContent" Grid.Row="1" Margin="20,4,20,14" Focusable="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
