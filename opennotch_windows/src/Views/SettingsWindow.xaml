<Window x:Class="OpenNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenNotch"
        Title="{l:T 'Configurações do OpenNotch'}" Width="520" Height="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <StackPanel.Resources>
                <Style TargetType="GroupBox">
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Setter Property="Padding" Value="10,8" />
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Margin" Value="0,3" />
                </Style>
            </StackPanel.Resources>

            <GroupBox Header="{l:T 'Geral'}">
                <StackPanel>
                    <CheckBox Content="{l:T 'Abrir ao passar o mouse'}" IsChecked="{Binding HoverOpens}" />
                    <CheckBox Content="{l:T 'Mostrar em todos os monitores'}" IsChecked="{Binding DisplayAllScreens}" />
                    <CheckBox Content="{l:T 'Ativar atalhos do OpenNotch'}" IsChecked="{Binding HotkeysEnabled}" />
                    <TextBlock Text="{l:T 'Ctrl + Alt + N abre o notch, V abre Textos e S abre Captura de tela.'}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,4" />
                    <CheckBox x:Name="Startup" Content="{l:T 'Abrir ao iniciar o Windows'}" Click="OnStartup" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{l:T 'Idioma'}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="Language" Width="180" SelectionChanged="OnLanguage">
                            <ComboBoxItem Tag="" Content="{l:T 'Igual ao do sistema'}" />
                            <ComboBoxItem Tag="pt-BR" Content="Português" />
                            <ComboBoxItem Tag="en" Content="English" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="LanguageNote" Text="{l:T 'O idioma muda na próxima vez que o app for aberto.'}"
                               Foreground="Gray" FontSize="11" Visibility="Collapsed" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:T 'Módulos'}">
                <UniformGrid Columns="2">
                    <CheckBox Content="{l:T 'Música'}" IsChecked="{Binding ModMusic}" />
                    <CheckBox Content="{l:T 'Agentes de IA'}" IsChecked="{Binding ModAgents}" />
                    <CheckBox Content="{l:T 'Gerenciador de apps abertos'}" IsChecked="{Binding ModApps}" />
                    <CheckBox Content="{l:T 'Captura de tela'}" IsChecked="{Binding ModCapture}" />
                    <CheckBox Content="{l:T 'Anotações'}" IsChecked="{Binding ModNotes}" />
                    <CheckBox Content="{l:T 'Histórico de textos copiados'}" IsChecked="{Binding ModClipboard}" />
                    <CheckBox Content="{l:T 'Bandeja de arquivos'}" IsChecked="{Binding ModTray}" />
                    <CheckBox Content="{l:T 'Progresso de downloads'}" IsChecked="{Binding ModDownloads}" />
                    <CheckBox Content="{l:T 'Timers'}" IsChecked="{Binding ModTimers}" />
                    <CheckBox Content="{l:T 'Monitor do sistema'}" IsChecked="{Binding ModSystem}" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="{l:T 'Agentes de IA'}">
                <StackPanel>
                    <CheckBox Content="Claude Code" IsChecked="{Binding AgentsClaude}" />
                    <CheckBox Content="Codex" IsChecked="{Binding AgentsCodex}" />
                    <CheckBox Content="{l:T 'Abrir o notch para avisar'}" IsChecked="{Binding AgentsNotify}" />
                    <CheckBox Content="{l:T 'Tocar som'}" IsChecked="{Binding AgentsSound}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:T 'Textos'}">
                <StackPanel>
                    <CheckBox Content="{l:T 'Manter o histórico ao fechar o app'}" IsChecked="{Binding ClipPersist}" />
                    <CheckBox Content="{l:T 'Tocar som ao terminar'}" IsChecked="{Binding TimersSound}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:T 'Captura de tela'}">
                <StackPanel>
                    <CheckBox Content="{l:T 'Copiar automaticamente'}" IsChecked="{Binding CaptureAutoCopy}" />
                    <CheckBox Content="{l:T 'Abrir o notch mostrando a captura'}" IsChecked="{Binding CaptureShowAfter}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:T 'Atualizações'}">
                <StackPanel>
                    <TextBlock x:Name="UpdateStatus" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T 'Verificar agora'}" Padding="10,3" Click="OnCheckUpdate" />
                        <Button x:Name="DownloadButton" Content="{l:T 'Abrir página de download'}" Padding="10,3"
                                Margin="8,0,0,0" Click="OnDownload" Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox Content="{l:T 'Verificar atualizações automaticamente'}" IsChecked="{Binding UpdateAutoCheck}"
                              Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:T 'Configurações'}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T 'Exportar…'}" Padding="10,3" Click="OnExport" />
                        <Button Content="{l:T 'Importar…'}" Padding="10,3" Margin="8,0,0,0" Click="OnImport" />
                    </StackPanel>
                    <TextBlock x:Name="TransferMessage" Foreground="Gray" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>

            <DockPanel LastChildFill="False">
                <TextBlock x:Name="VersionText" Foreground="Gray" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{l:T 'Sair do OpenNotch'}" Padding="10,3" Click="OnQuit" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
